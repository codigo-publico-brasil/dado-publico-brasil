# Modelo do `.env.servidor` (copie para `.env.servidor`, fora do git; `scripts/servidor.sh preparar` faz isso e copia do
# `.env` local só as variáveis do R2). Nunca coloque aqui o DSN nem as senhas do Postgres. Segredos ficam só no arquivo
# real. Valores com `$` vão entre aspas simples (SENHA='a$b').

# Quais compose usar com `docker --context servidor compose --env-file .env.servidor`
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=compose.yaml,compose.servidor.yaml
DADO_PUBLICO_ENV_FILE=.env.servidor

# SSH do servidor (usado por scripts/servidor.sh)
SERVIDOR_SSH=usuario@host
SERVIDOR_SSH_PORT=22

# Pasta de dados no servidor (caminho absoluto) e interface do Dagster (sem login: BIND só com IP de VPN ou rede
# local confiável, nunca 0.0.0.0 num servidor exposto)
DADO_PUBLICO_DATA_DIR=/srv/dado-publico
DADO_PUBLICO_BIND=127.0.0.1
DADO_PUBLICO_PORT=3000

# Memória (padrões servem a 8 GB de RAM; em máquina compartilhada, baixe; em máquina maior, suba)
DADO_PUBLICO_MEM_LIMIT=6g
DADO_PUBLICO_DUCKDB_MEMORY=4GB

# Lake público e buckets do R2 (obrigatórios; copiados do `.env` local pelo `preparar`)
DADO_PUBLICO_LAKE_URL=
DADO_PUBLICO_R2_ACCOUNT_ID=
DADO_PUBLICO_R2_ACCESS_KEY_ID=
DADO_PUBLICO_R2_SECRET_ACCESS_KEY=
DADO_PUBLICO_R2_BUCKET=
DADO_PUBLICO_R2_BUCKET_PRIVADO=
